---
/**
 * Contact section — ported from the live site's Home page, ready to
 * ship for the cutover (was deliberately deferred out of Phase 1 for
 * scope; restored now that a real, unbroken contact path is a
 * cutover blocker, not a nice-to-have).
 *
 * Posts to /api/contact (functions/api/contact.js, already ported
 * byte-identical in Phase 1) which upserts the sender into Brevo and
 * emails the team. Honeypot field silently drops bot submissions on
 * the function side.
 */
import { copy, type Locale } from '../i18n/copy';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = copy[locale].contact;
---
<section class="contact-section" id="contact">
  <div class="contact-inner">
    <div class="contact-copy">
      <h3>{t.title}</h3>
      <p>{t.body}</p>
    </div>

    <div>
      <form class="contact-form" id="contactForm" name="contact" method="POST">
        <p style="display:none">
          <label>{t.honeypotLabel} <input name="bot-field" /></label>
        </p>

        <div class="contact-field">
          <label for="contactName">{t.nameLabel} <span class="optional">{t.nameOptional}</span></label>
          <input type="text" id="contactName" name="name" placeholder={t.namePlaceholder} autocomplete="name" />
        </div>

        <div class="contact-field">
          <label for="contactEmail">{t.emailLabel}</label>
          <input type="email" id="contactEmail" name="email" placeholder={t.emailPlaceholder} autocomplete="email" required />
        </div>

        <div class="contact-field">
          <label for="contactMessage">{t.messageLabel}</label>
          <textarea id="contactMessage" name="message" placeholder={t.messagePlaceholder} required></textarea>
        </div>

        <button type="submit" class="contact-submit" id="contactSubmit" data-sending-label={t.sending}>{t.submit}</button>
      </form>

      <div class="contact-success" id="contactSuccess">
        <div class="success-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <div class="success-title">{t.successTitle}</div>
        <p class="success-sub">{t.successBody}</p>
      </div>
    </div>
  </div>
</section>

<script>
  // Same behaviour as the live site: the fetch failing (e.g. a 404
  // against a local static server with no /api/contact Function) is
  // swallowed and the UI still shows success, since production is
  // where this actually has to work.
  const contactForm    = document.getElementById('contactForm') as HTMLFormElement | null;
  const contactSubmit  = document.getElementById('contactSubmit') as HTMLButtonElement | null;
  const contactSuccess = document.getElementById('contactSuccess');

  if (contactForm && contactSubmit && contactSuccess) {
    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      contactSubmit.disabled = true;
      contactSubmit.textContent = contactSubmit.dataset.sendingLabel || 'Sending…';

      const data = new FormData(contactForm);
      const payload = {
        name:        data.get('name')      || '',
        email:       data.get('email')     || '',
        message:     data.get('message')   || '',
        'bot-field': data.get('bot-field') || '',
      };
      try {
        await fetch('/api/contact', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify(payload),
        });
      } catch (_err) {
        // Silent — matches the live site's documented behaviour.
      } finally {
        contactForm.style.display   = 'none';
        contactSuccess.style.display = 'block';
      }
    });
  }
</script>
