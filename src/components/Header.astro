---
// Brand mark SVG is the exact same geometry as GidslyLogo.tsx in the app
// repo and the live site's nav — kept identical across every surface.
import { copy, type Locale } from '../i18n/copy';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = copy[locale].nav;

const home = locale === 'nl' ? '/nl' : '/';
const localize = (p: string) => (locale === 'nl' ? (p === '/' ? '/nl' : `/nl${p}`) : p);
---
<nav>
  <a href={home} class="brand" aria-label="Gidsly home">
    <svg class="brand-mark" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect width="100" height="100" fill="#1c4538"/>
      <text x="50" y="72" text-anchor="middle" fill="#f5e3cc"
            style="font-family:'Libre Baskerville',serif;font-weight:700;font-size:75px;">G</text>
    </svg>
    <span class="brand-word">Gidsly</span>
  </a>
  <div class="nav-right">
    <div class="nav-actions">
      <a href={localize('/how-it-works')} class="nav-login">{t.howItWorks}</a>
      <a href={localize('/pricing')} class="nav-login">{t.pricing}</a>
      <a href={localize('/about')} class="nav-login">{t.about}</a>
      <a href="https://app.gidsly.com/#/auth/signin" class="nav-login">{t.login}</a>
      <a href="https://app.gidsly.com/#/auth/create-account" class="nav-register">{t.signup}</a>
    </div>
  </div>
</nav>
