---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import { copy, type Locale } from '../i18n/copy';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = copy[locale].about;
const cc = copy[locale].closeCta;
const path = locale === 'nl' ? '/nl/about' : '/about';
---
<BaseLayout title={t.title} description={t.description} path={path} locale={locale}>
  <Header locale={locale} basePath="/about" />

  <!--
    FOUNDER NOTE — Willem's own words, translated faithfully for the
    Dutch version, not rewritten. Photo is real (public/images/willem.jpg).
  -->
  <section class="about-section">
    <img class="about-photo" src="/images/willem.jpg" alt="Willem, founder of Gidsly" width="600" height="600" />

    <div class="about-copy">
      <h1>{t.heading}</h1>
      {t.paragraphs.map((p) => <p>{p}</p>)}
      <p class="about-signoff">{t.signoff}</p>
    </div>
  </section>

  <section class="close-cta">
    <h2 class="close-title">{t.closeTitle}</h2>
    <p class="close-sub">{cc.sub}</p>
    <a href="https://app.gidsly.com/#/auth/create-account" class="btn-primary">{cc.cta}</a>
    <p class="form-note">{cc.note}</p>
  </section>

  <ContactForm locale={locale} />

  <Footer locale={locale} />
</BaseLayout>
