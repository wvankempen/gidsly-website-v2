---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { copy, type Locale } from '../i18n/copy';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = copy[locale].howItWorks;
const cc = copy[locale].closeCta;
const path = locale === 'nl' ? '/nl/how-it-works' : '/how-it-works';
---
<BaseLayout title={t.title} description={t.description} path={path} locale={locale}>
  <Header locale={locale} basePath="/how-it-works" />

  <section class="how-hero">
    <h1>{t.heroTitle}</h1>
    <p>{t.heroSub}</p>
  </section>

  <section class="how-steps">
    <!-- Step 1: Journeys -->
    <div class="how-step">
      <div class="how-step-copy">
        <span class="how-step-num">01</span>
        <h2>{t.step1.title}</h2>
        <p>{t.step1.body}</p>
      </div>
      <div class="how-step-visual" aria-hidden="true">
        <div class="panel-timeline">
          <div class="panel-timeline-head">
            <div class="app-avatar">O</div>
            <div>
              <div class="title">{t.step1.mockupTitle}</div>
              <div class="sub">{t.step1.mockupSub}</div>
            </div>
          </div>
          <div class="tl-item"><span class="tl-dot"></span><span class="tl-label">Researching</span><span class="tl-date">Mar 3</span></div>
          <div class="tl-item"><span class="tl-dot"></span><span class="tl-label">Ready to Apply</span><span class="tl-date">Mar 10</span></div>
          <div class="tl-item"><span class="tl-dot"></span><span class="tl-label">Applied</span><span class="tl-date">Mar 14</span></div>
          <div class="tl-item"><span class="tl-dot"></span><span class="tl-label">Interviewing <span class="tl-current">{t.step1.now}</span></span><span class="tl-date">Apr 2</span></div>
          <div class="tl-item upcoming"><span class="tl-dot upcoming"></span><span class="tl-label">{t.step1.upcoming}</span><span class="tl-date">Apr 18</span></div>
        </div>
      </div>
    </div>

    <!-- Step 2: Companion -->
    <div class="how-step reverse">
      <div class="how-step-copy">
        <span class="how-step-num">02</span>
        <h2>{t.step2.title}</h2>
        <p>{t.step2.body}</p>
      </div>
      <div class="how-step-visual" aria-hidden="true">
        <div class="panel-chat">
          <div class="chat-msg">
            <div class="chat-avatar user">W</div>
            <div class="chat-body">
              <div class="chat-name">{t.step2.youLabel}</div>
              <div class="chat-text">{t.step2.userMsg}</div>
            </div>
          </div>
          <div class="chat-msg">
            <div class="chat-avatar gidsly">G</div>
            <div class="chat-body">
              <div class="chat-name">{t.step2.gidslyLabel}</div>
              <div class="chat-text">{t.step2.gidslyMsg}</div>
              <div class="chat-voice">
                <svg viewBox="0 0 24 24"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/></svg>
                <span>{t.step2.voiceAvailable}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Step 3: My Essence -->
    <div class="how-step">
      <div class="how-step-copy">
        <span class="how-step-num">03</span>
        <h2>{t.step3.title}</h2>
        <p>{t.step3.body}</p>
      </div>
      <div class="how-step-visual" aria-hidden="true">
        <div class="panel-essence">
          <div class="essence-head">
            <div class="essence-avatar">S</div>
            <div>
              <div class="essence-name">{t.step3.mockupName}</div>
              <div class="essence-role">{t.step3.mockupRole}</div>
            </div>
          </div>
          <div class="essence-section">
            <p class="essence-section-label">{t.step3.skillsLabel}</p>
            <div class="essence-chips">
              <span class="essence-chip">{t.step3.skills[0]}</span>
              <span class="essence-chip">{t.step3.skills[1]}</span>
              <span class="essence-chip">{t.step3.skills[2]}</span>
            </div>
          </div>
          <div class="essence-section">
            <p class="essence-section-label">{t.step3.mattersLabel}</p>
            <p class="essence-note">{t.step3.mattersText}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="close-cta">
    <h2 class="close-title">{t.closeTitle}</h2>
    <p class="close-sub">{cc.sub}</p>
    <a href="https://app.gidsly.com/#/auth/create-account" class="btn-primary">{cc.cta}</a>
    <p class="form-note">{cc.note}</p>
  </section>

  <Footer locale={locale} />
</BaseLayout>
