---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PricingCard from '../components/PricingCard.astro';
import { copy, type Locale } from '../i18n/copy';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = copy[locale].pricing;
const path = locale === 'nl' ? '/nl/pricing' : '/pricing';

// Plan data sourced from the app's own billing config (services/billing.ts,
// public/locales/en/billing.json in the main Gidsly repo) — the
// authoritative source, not re-typed from memory.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Gidsly',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  offers: [
    { '@type': 'Offer', name: 'Basic', price: '0', priceCurrency: 'EUR' },
    { '@type': 'Offer', name: 'Premium (monthly)', price: '9.95', priceCurrency: 'EUR' },
    { '@type': 'Offer', name: 'Premium (annual)', price: '99.50', priceCurrency: 'EUR' },
  ],
};
---
<BaseLayout title={t.title} description={t.description} path={path} locale={locale} structuredData={[productSchema, faqSchema]}>
  <Header locale={locale} basePath="/pricing" />

  <section class="pricing-hero">
    <h1>{t.heroTitle}</h1>
    <p>{t.heroSub}</p>
  </section>

  <div class="pricing-cards">
    <PricingCard
      name={t.basic.name}
      amount={locale === 'nl' ? 'Gratis' : 'Free'}
      note={t.basic.note}
      features={t.basic.features}
      ctaLabel={t.basic.cta}
    />
    <PricingCard
      name={t.premium.name}
      amount={locale === 'nl' ? '€9,95' : '€9.95'}
      unit={locale === 'nl' ? '/ maand' : '/ month'}
      note={t.premium.note}
      featured
      badge={t.premium.badge}
      features={t.premium.features}
      ctaLabel={t.premium.cta}
    />
  </div>

  <section class="pricing-faq">
    <p class="section-eyebrow">{t.faqEyebrow}</p>
    <h2 class="section-title">{t.faqTitle}</h2>
    {t.faqs.map((faq) => (
      <div class="faq-item">
        <p class="faq-q">{faq.q}</p>
        <p class="faq-a">{faq.a}</p>
      </div>
    ))}
  </section>

  <Footer locale={locale} basePath="/pricing" />
</BaseLayout>
