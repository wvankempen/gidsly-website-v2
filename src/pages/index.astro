---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { copy, type Locale } from '../i18n/copy';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = copy[locale].home;
const cc = copy[locale].closeCta;
const path = locale === 'nl' ? '/nl' : '/';

// Derived straight from canon section 1 ("gets better at helping them
// every time, because what it learns about them persists"). The hero
// H1 tagline itself stays English in both locales -- same precedent
// as the app's own nl/common.json, which keeps "Your Personal Career
// Companion" in English rather than translating it.
---
<BaseLayout title={t.title} description={t.description} path={path} locale={locale}>
  <Header locale={locale} basePath="/" />

  <!-- HERO ────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <h1>The career companion<br>you <em>wish</em><br>you'd had.</h1>
        <p class="hero-sub">
          {t.description} {t.heroSubExtra}
        </p>
        <div class="hero-cta">
          <a href="https://app.gidsly.com/#/auth/create-account" class="btn-primary">{t.ctaPrimary}</a>
          <a href={locale === 'nl' ? '/nl/pricing' : '/pricing'} class="btn-ghost">{t.ctaSecondary}</a>
        </div>
      </div>

      <!-- Stylised Journeys page. Pure HTML/CSS, nothing loaded
           from the actual app. Three sample rows convey "this tracks
           every Journey" at a glance. Stage labels (Researching,
           Interviewing, Offer Received) stay English in both locales,
           matching the app's own pipeline vocabulary. -->
      <div class="hero-visual" aria-hidden="true">
        <div class="app-preview">
          <div class="app-preview-chrome">
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          </div>
          <div class="app-preview-body">
            <div class="app-preview-head">
              <h4>{t.mockup.heading}</h4>
              <span>{t.mockup.active}</span>
            </div>
            <div class="app-row">
              <div class="app-avatar">P</div>
              <div class="app-info">
                <div class="app-role">Senior Product Manager</div>
                <div class="app-co">Pulse Fintech &middot; Amsterdam</div>
              </div>
              <span class="app-stage stage-discovery">Researching</span>
            </div>
            <div class="app-row">
              <div class="app-avatar">O</div>
              <div class="app-info">
                <div class="app-role">Head of Design</div>
                <div class="app-co">Orbit Studios &middot; Utrecht</div>
              </div>
              <span class="app-stage stage-interview">Interviewing</span>
            </div>
            <div class="app-row">
              <div class="app-avatar">L</div>
              <div class="app-info">
                <div class="app-role">Staff Engineer</div>
                <div class="app-co">Lumen Health &middot; Remote</div>
              </div>
              <span class="app-stage stage-offer">Offer Received</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES ────────────────────────────────────────────── -->
  <section class="features" id="features">
    <p class="section-eyebrow">{t.featuresEyebrow}</p>
    <h2 class="section-title">{t.featuresTitle}</h2>
    <div class="feat-grid">
      <div class="feat-card">
        <div class="feat-icon"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="5" height="18" rx="1"/><rect x="10" y="7" width="5" height="14" rx="1"/><rect x="17" y="11" width="4" height="10" rx="1"/></svg></div>
        <h3 class="feat-title">{t.features[0].title}</h3>
        <p class="feat-desc">{t.features[0].desc}</p>
      </div>
      <div class="feat-card">
        <div class="feat-icon"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M9.5 12.5l1.5 1.5 3-3"/></svg></div>
        <h3 class="feat-title">{t.features[1].title}</h3>
        <p class="feat-desc">{t.features[1].desc}</p>
      </div>
      <div class="feat-card">
        <div class="feat-icon"><svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></div>
        <h3 class="feat-title">{t.features[2].title}</h3>
        <p class="feat-desc">{t.features[2].desc}</p>
      </div>
      <div class="feat-card">
        <div class="feat-icon"><svg viewBox="0 0 24 24"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg></div>
        <h3 class="feat-title">{t.features[3].title}</h3>
        <p class="feat-desc">{t.features[3].desc}</p>
      </div>
    </div>
  </section>

  <!-- WHY — warm band, no fake attribution ───────────────── -->
  <div class="why">
    <div class="why-inner">
      <div class="why-eyebrow">{t.whyEyebrow}</div>
      <p class="why-text">
        {t.whyText}
        <strong>{t.whyStrong}</strong>
      </p>
    </div>
  </div>

  <!-- CLOSING CTA ─────────────────────────────────────────── -->
  <section class="close-cta">
    <h2 class="close-title">{t.closeTitle}</h2>
    <p class="close-sub">{cc.sub}</p>
    <a href="https://app.gidsly.com/#/auth/create-account" class="btn-primary">{cc.cta}</a>
    <p class="form-note">{cc.note}</p>
  </section>

  <Footer locale={locale} basePath="/" />
</BaseLayout>
