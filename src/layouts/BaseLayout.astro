---
/**
 * BaseLayout — shared <head> + font loading + global.css for every page.
 *
 * Every page hand-writes its own title/description (no templated
 * boilerplate, per the rebuild plan §5) and passes it in as props.
 * `structuredData` accepts one or more JSON-LD objects so a page can
 * add its own schema (Product/FAQPage on Pricing, Article on future
 * blog posts) on top of the Organization schema every page carries.
 */
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Canonical + OG url, absolute, no trailing content beyond the path. */
  path: string;
  /** Extra JSON-LD objects beyond the Organization schema every page gets. */
  structuredData?: object[];
  locale?: 'en' | 'nl';
  /** False for the legal pages -- no /nl/ counterpart exists yet. */
  hasAltLocale?: boolean;
}

const { title, description, path, structuredData = [], locale = 'en', hasAltLocale = true } = Astro.props;
const canonicalUrl = `https://gidsly.com${path}`;

// path is always the page's own locale-specific canonical path (e.g. "/pricing"
// for EN, "/nl/pricing" for NL). Derive the other locale's URL by toggling the
// /nl prefix, so hreflang always points at a real, matching page.
const enPath = locale === 'nl' ? (path === '/nl' ? '/' : path.replace(/^\/nl/, '')) : path;
const nlPath = locale === 'en' ? (path === '/' ? '/nl' : `/nl${path}`) : path;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Gidsly',
  legalName: 'Van Kempen Ventures and Consultancy',
  url: 'https://gidsly.com/',
  logo: 'https://gidsly.com/brand/icons/gidsly-favicon-512.png',
  // Reuse the page's own description rather than a second, independent
  // copy of similar-but-not-identical text — the two had drifted
  // (this one still said "application" after the canon-alignment pass;
  // see docs/gidsly-canon.md).
  description,
  sameAs: [
    'https://www.linkedin.com/company/gidsly',
    'https://www.instagram.com/gidsly/',
  ],
};

const allSchema = [organizationSchema, ...structuredData];
---
<!doctype html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Canonical: apex gidsly.com (not www), absolute + consistent so
       Google sees one entity per URL. -->
  <link rel="canonical" href={canonicalUrl} />

  {hasAltLocale && (
    <>
      <link rel="alternate" hreflang="en" href={`https://gidsly.com${enPath}`} />
      <link rel="alternate" hreflang="nl" href={`https://gidsly.com${nlPath}`} />
      <link rel="alternate" hreflang="x-default" href={`https://gidsly.com${enPath}`} />
    </>
  )}

  <!-- Open Graph / social share -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://gidsly.com/gidsly-og-banner.png" />
  <meta property="og:image:alt" content="Gidsly, your career companion." />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="Gidsly" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://gidsly.com/gidsly-og-banner.png" />

  {allSchema.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}

  <!-- Same icon set + manifest as the app (public/brand/icons in the
       Gidsly app repo), not the marketing site's older one-off files —
       one brand asset source, not two drifting sets. -->
  <link rel="icon" type="image/png" sizes="16x16" href="/brand/icons/gidsly-favicon-16.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/brand/icons/gidsly-favicon-32.png" />
  <link rel="icon" type="image/png" sizes="48x48" href="/brand/icons/gidsly-favicon-48.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/brand/icons/gidsly-favicon-192.png" />
  <link rel="shortcut icon" href="/brand/icons/gidsly-favicon-32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/brand/icons/gidsly-apple-touch-icon-180.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Three faces: Fraunces for editorial headlines, Inter for body
       copy (matches the app), Libre Baskerville Bold for the single
       "G" in the brand mark (matches GidslyLogo.tsx in the app repo). -->
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,700;0,9..144,900;1,9..144,300&family=Inter:wght@300;400;500;600;700&family=Libre+Baskerville:wght@700&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="wrapper">
    <slot />
  </div>
</body>
</html>
